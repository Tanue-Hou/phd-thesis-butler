{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://phd-thesis-butler/schemas/chapter_evidence_map.schema.json",
  "title": "Chapter Evidence Map",
  "description": "Aggregated evidence bindings and gap analysis for a single thesis chapter. Version 1.0.",
  "type": "object",
  "required": [
    "chapter_id",
    "chapter_name",
    "bound_records",
    "gap_analysis"
  ],
  "properties": {
    "chapter_id": {
      "type": "string",
      "description": "Unique chapter identifier, e.g. 'CH1', 'CH2'",
      "pattern": "^(INTRO|SURVEY|THEORY|MODEL|METHOD|EXPERIMENT|RESULT|DISCUSSION|CONCLUSION|CH[1-9]+)$"
    },
    "chapter_name": {
      "type": "string",
      "description": "Human-readable chapter name, e.g. 'Introduction', 'Literature Review', 'Методология'"
    },
    "bound_records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "binding_id",
          "source_id",
          "evidence_role",
          "evidence_strength",
          "gap_status",
          "recommended_action"
        ],
        "properties": {
          "binding_id": {
            "type": "string",
            "description": "Reference to the evidence_binding_record ID"
          },
          "claim_type": {
            "type": "string",
            "enum": [
              "factual_claim",
              "methodological_claim",
              "evaluative_claim",
              "gap_claim",
              "contribution_claim",
              "theoretical_claim",
              "descriptive_claim",
              "common_knowledge"
            ]
          },
          "evidence_roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "background_context",
                "research_gap",
                "definition",
                "method_basis",
                "method_comparison",
                "benchmark",
                "validation_standard",
                "empirical_support",
                "contradiction",
                "contribution_positioning",
                "structure_reference",
                "supplementary_detail"
              ]
            }
          },
          "evidence_strength": {
            "type": "string",
            "enum": [
              "strong",
              "medium",
              "weak",
              "none"
            ]
          },
          "gap_status": {
            "type": "string",
            "enum": [
              "covered",
              "partial",
              "missing",
              "not_needed"
            ]
          },
          "evidence_role": {
            "type": "string",
            "description": "Single evidence role (canonical role name)"
          },
          "source_id": {
            "type": "string"
          },
          "recommended_action": {
            "type": "string"
          },
          "claim_text": {
            "type": "string",
            "description": "Optional claim text"
          }
        }
      },
      "description": "All binding records associated with this chapter"
    },
    "gap_analysis": {
      "type": "object",
      "required": [
        "total_bound",
        "covered",
        "partial",
        "missing",
        "coverage_ratio",
        "unresolved_gaps"
      ],
      "properties": {
        "total_claims": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of claim sentences identified in this chapter"
        },
        "covered": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of claims with gap_status = covered"
        },
        "partial": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of claims with gap_status = partial"
        },
        "missing": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of claims with gap_status = missing"
        },
        "not_needed": {
          "type": "integer",
          "description": "Optional"
        },
        "coverage_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Proportion of claims that are covered (covered + not_needed) / total"
        },
        "unresolved_gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "evidence_role",
              "status"
            ],
            "properties": {
              "binding_id": {
                "type": "string"
              },
              "claim_text": {
                "type": "string",
                "description": "The claim that has a gap. Example (RU): 'Проблема верификации цитат остаётся неизученной.'"
              },
              "missing_roles": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Evidence roles that are not yet covered"
              },
              "risk_level": {
                "type": "string",
                "enum": [
                  "critical",
                  "high",
                  "medium",
                  "low"
                ]
              },
              "recommended_query": {
                "type": "string",
                "description": "Suggested search query to find a source. Example (RU): 'верификация цитат RAG системы исследование'"
              },
              "evidence_role": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "covered",
                  "partial",
                  "missing",
                  "not_needed"
                ]
              },
              "recommended_source_type": {
                "type": "string"
              }
            }
          },
          "description": "List of gaps that need resolution"
        },
        "total_bound": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "required_roles_present": {
      "type": "object",
      "description": "Map of required roles for this chapter to their presence status",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "present",
          "missing",
          "partial"
        ]
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when this map was generated"
    }
  },
  "additionalProperties": false
}