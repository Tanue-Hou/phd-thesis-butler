# Runtime logs (auto-generated by scripts)
logs/*.log
logs/*.pid

# Except operations log (manual, tracked)
!logs/operations.log

# Data - too large for git
data/MSU/*
data/SPbSU/*
data/BMSTU/*

# But keep empty dir markers
!data/MSU/.gitkeep
!data/SPbSU/.gitkeep
!data/BMSTU/.gitkeep

# Temp
*.tmp
*.temp
__pycache__/
*.pyc
